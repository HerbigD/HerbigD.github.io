---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllWriting } from '../lib/posts';

const PER_PAGE = 10;
const all = await getAllWriting();
const posts = all.slice(0, PER_PAGE);
const rest = all.length - posts.length;
---

<BaseLayout title="Home" description="头大的D 的个人网站：写点东西。">
  <section class="home-hero">
    <p class="hero-label">HERE AND NOW.</p>
    <h1 class="hero-title">现实太闷，到梦境旅行。</h1>
    <p class="hero-subtitle">恍惚的面对世界，笔直的面对自己。</p>
  </section>

  <div class="post-stream">
    {posts.map(w => <PostCard writing={w} />)}
  </div>

  {rest > 0 && (
    <p class="stream-more"><a href="/archive">还有 {rest} 篇更早的文字 →</a></p>
  )}
</BaseLayout>
