---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allItems = (await getCollection('collection')).filter(p => !p.data.draft);

const counts = {
  book: allItems.filter(i => i.data.type === 'book').length,
  film: allItems.filter(i => i.data.type === 'film').length,
  music: allItems.filter(i => i.data.type === 'music').length,
  item: allItems.filter(i => i.data.type === 'item').length,
};

const categories = [
  { type: 'book',  label: 'book',       count: counts.book },
  { type: 'film',  label: 'film',       count: counts.film },
  { type: 'music', label: 'music',      count: counts.music },
  { type: 'item',  label: 'belongings', count: counts.item },
];
---

<BaseLayout title="Collections" description="book, film, music, belongings">
  <div class="page-header">
    <h1>Collections</h1>
    <p>book, film, music, belongings</p>
  </div>

  <div class="collection-hub">
    {categories.map(cat => (
      <a href={`/collection/${cat.type}/`} class="collection-category-card">
        <span class="category-en">{cat.label}</span>
        <span class="category-count">{cat.count} 条</span>
      </a>
    ))}
  </div>
</BaseLayout>
