---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allItems = (await getCollection('collection')).filter(p => !p.data.draft);

const counts = {
  book: allItems.filter(i => i.data.type === 'book').length,
  film: allItems.filter(i => i.data.type === 'film').length,
  music: allItems.filter(i => i.data.type === 'music').length,
  podcast: allItems.filter(i => i.data.type === 'podcast').length,
};

const categories = [
  { type: 'book',    zh: '书',   en: 'Books',    emoji: '📖', count: counts.book },
  { type: 'film',    zh: '影',   en: 'Films',    emoji: '🎬', count: counts.film },
  { type: 'music',   zh: '音乐', en: 'Music',    emoji: '🎵', count: counts.music },
  { type: 'podcast', zh: '播客', en: 'Podcasts', emoji: '🎙', count: counts.podcast },
];
---

<BaseLayout title="Collections" description="读过的、看过的、听过的">
  <div class="page-header">
    <h1>Collections</h1>
    <p>读过的、看过的、听过的 ｜ Things that stayed with me</p>
  </div>

  <div class="collection-hub">
    {categories.map(cat => (
      <a href={`/collection/${cat.type}/`} class="collection-category-card">
        <span class="category-icon">{cat.emoji}</span>
        <span class="category-zh">{cat.zh}</span>
        <span class="category-en">{cat.en}</span>
        <span class="category-count">{cat.count} 条</span>
      </a>
    ))}
  </div>
</BaseLayout>
