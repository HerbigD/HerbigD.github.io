---
import PostLayout from '../../layouts/PostLayout.astro';
import { writingPaths, type Writing } from '../../lib/posts';

export async function getStaticPaths() {
  return writingPaths('diary');
}

interface Props { writing: Writing; newer?: Writing; older?: Writing }
const { writing, newer, older } = Astro.props;
const { Content } = await writing.entry.render();
---

<PostLayout
  title={writing.title}
  date={writing.date}
  description={writing.excerpt}
  backHref="/diary/"
  backLabel="diary"
  minutes={writing.minutes}
  newer={newer}
  older={older}
>
  <Content />
</PostLayout>
