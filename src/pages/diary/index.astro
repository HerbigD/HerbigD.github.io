---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllWriting } from '../../lib/posts';

const posts = (await getAllWriting()).filter(w => w.section === 'diary');
---

<BaseLayout title="Diary" description="每天的日记">
  <div class="page-header">
    <h1>diary</h1>
    <p>生活，生活，今天我们好好的过</p>
  </div>

  {posts.length === 0 ? (
    <p class="empty">还没有内容，敬请期待。</p>
  ) : (
    <div class="post-stream">
      {posts.map(w => <PostCard writing={w} showSection={false} />)}
    </div>
  )}
</BaseLayout>
