---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllWriting, formatDate, sectionLabel } from '../lib/posts';

const all = await getAllWriting();
const years = new Map<number, typeof all>();
for (const w of all) {
  const y = w.date.getUTCFullYear();
  if (!years.has(y)) years.set(y, []);
  years.get(y)!.push(w);
}
---

<BaseLayout title="Archive" description="所有文字">
  <div class="page-header">
    <h1>archive</h1>
    <p>共 {all.length} 篇</p>
  </div>

  {[...years].map(([year, list]) => (
    <section class="archive-year">
      <h2 id={`y${year}`}>{year}<span>{list.length}</span></h2>
      <ul class="post-list">
        {list.map(w => (
          <li class="post-list-item">
            <time class="post-date" datetime={w.date.toISOString()}>{formatDate(w.date).slice(5)}</time>
            <a href={w.url} class="post-title">{w.title}</a>
            <span class="post-section">{sectionLabel[w.section]}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
