---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaCoverCard from '../../components/MediaCoverCard.astro';

const items = (await getCollection('belongings'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Belongings" description="值得记录的物品">
  <div class="page-header">
    <h1>belongings</h1>
    <p>一些恋物癖</p>
  </div>

  {items.length === 0 ? (
    <p class="empty">还没有内容，敬请期待。</p>
  ) : (
    <div class="media-cover-grid">
      {items.map(item => (
        <MediaCoverCard
          title={item.data.title}
          href={`/belongings/${item.slug}/`}
          cover={item.data.cover}
          meta={item.data.description}
        />
      ))}
    </div>
  )}
</BaseLayout>
