---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const items = (await getCollection('belongings')).filter(p => !p.data.draft);
  return items.map(item => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<PostLayout
  title={item.data.title}
  date={item.data.date}
  description={item.data.description}
  backHref="/belongings/"
  backLabel="belongings"
  minutes={readingMinutes(item.body)}
>
  <Content />
</PostLayout>
