---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllWriting } from '../../lib/posts';

const posts = (await getAllWriting()).filter(w => w.section === 'thoughts');
---

<BaseLayout title="Thoughts" description="胡思乱想">
  <div class="page-header">
    <h1>thoughts</h1>
    <p>胡思乱想</p>
  </div>

  {posts.length === 0 ? (
    <p class="empty">还没有内容，敬请期待。</p>
  ) : (
    <div class="post-stream">
      {posts.map(w => <PostCard writing={w} showSection={false} />)}
    </div>
  )}
</BaseLayout>
