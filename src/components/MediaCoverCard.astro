---
interface Props {
  title: string;
  href: string;
  cover?: string;
  meta?: string;
}

const { title, href, cover, meta } = Astro.props;
---

<article class="media-cover-card">
  <a href={href}>
    <div class="cover-wrapper">
      {cover ? (
        <img src={cover} alt={title} loading="lazy" />
      ) : (
        <div class="cover-placeholder"><span>◇</span></div>
      )}
    </div>
    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      {meta && <p class="card-meta">{meta}</p>}
    </div>
  </a>
</article>
