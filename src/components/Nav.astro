---
const pathname = Astro.url.pathname;

const links = [
  { href: '/archive', label: 'archive' },
  { href: '/now', label: 'now' },
  { href: '/collection', label: 'collections' },
  { href: '/about', label: 'about' },
];
---

<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo" aria-label="首页">D.</a>
    <nav>
      <ul class="nav-links">
        {links.map(link => (
          <li>
            <a href={link.href} class={pathname.startsWith(link.href) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <button class="theme-toggle" type="button" aria-label="切换明暗" title="切换明暗"><span class="moon" aria-hidden="true"></span></button>
        </li>
      </ul>
    </nav>
  </div>
</header>
